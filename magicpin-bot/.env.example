# =============================================================================
# Magicpin Vera Bot - Environment Configuration Template
# =============================================================================
# Copy this file to .env and customize values for local development.
# In production (Render), set these variables directly in the Dashboard settings.
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL.
# =============================================================================

# Server Network & Runtime Configuration
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
APP_NAME="Magicpin Vera Bot"
APP_VERSION="1.0.0"

# Metadata Endpoint Values (GET /v1/metadata)
TEAM_NAME="Team Vera"
TEAM_MEMBERS='["Yashdeep", "Vera Team"]'
MODEL="gpt-4o"
APPROACH="deterministic trigger ranking + grounded LLM composition + output validation gate"
CONTACT_EMAIL="yashdeep.magicpin@gmail.com"

# Primary LLM Provider Configuration
# Provide one of: GEMINI_API_KEY, OPENAI_API_KEY, or LLM_API_KEY
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# LLM Timeout & Fallback Budget (in seconds)
# If the LLM does not respond within this budget, the bot immediately
# falls back to the deterministic template engine (safely under judge's budget)
LLM_TIMEOUT_SECONDS=8.0
